def fold(line: str) -> str:
    raw = line.encode("utf-8")
    if len(raw) <= 74:
        return line
    parts, current = [], b""
    for char in line:
        piece = char.encode("utf-8")
        limit = 74 if not parts else 73
        if len(current) + len(piece) > limit:
            parts.append(current)
            current = b""
        current += piece
    parts.append(current)
    return "\r\n ".join(p.decode("utf-8") for p in parts)


def esc(text: str) -> str:
    return (text.replace("\\", "\\\\").replace(";", "\\;").replace(",", "\\,")
            .replace("\n", "\\n"))


class Cal:
    def __init__(self, name: str, stamp: datetime):
        self.name = name
        self.stamp = utc_ics(stamp)
        self.events: list[list[str]] = []
        self.n = 0

    def add(self, summary: str, start: datetime | None = None, end: datetime | None = None, *,
            day: datetime | None = None, days: int = 1, location: str = "",
            description: str = "", rrule: str = "") -> None:
        self.n += 1
        lines = ["BEGIN:VEVENT", f"UID:demo-{self.name.lower()}-{self.n}@morgan.example",
                 f"DTSTAMP:{self.stamp}"]
        if day is not None:
            lines.append(f"DTSTART;VALUE=DATE:{day.strftime('%Y%m%d')}")
            lines.append(f"DTEND;VALUE=DATE:{(day + timedelta(days=days)).strftime('%Y%m%d')}")
        else:
            lines.append(f"DTSTART:{local_ics(start)}")
            lines.append(f"DTEND:{local_ics(end)}")
        if rrule:
            lines.append(f"RRULE:{rrule}")
        lines.append(f"SUMMARY:{esc(summary)}")
        if location:
            lines.append(f"LOCATION:{esc(location)}")
        if description:
            lines.append(f"DESCRIPTION:{esc(description)}")
        lines += ["STATUS:CONFIRMED", "END:VEVENT"]
        self.events.append(lines)

    def render(self) -> str:
        head = ["BEGIN:VCALENDAR", "VERSION:2.0", "PRODID:-//Mailday demo//EN",
                "CALSCALE:GREGORIAN", f"X-WR-CALNAME:{self.name}"]
        body = [fold(line) for event in self.events for line in event]
        return "\r\n".join(head + body + ["END:VCALENDAR", ""])


