def main() -> int:
    parser = argparse.ArgumentParser(description="Build a fictional Mailday demo home directory.")
    parser.add_argument("dir", help="directory to create")
    parser.add_argument("--now", help="reference time, local, e.g. 2026-10-14T09:30")
    parser.add_argument("--force", action="store_true",
                        help="rebuild DIR if it holds a .mailday-demo marker")
    args = parser.parse_args()

    root = Path(args.dir).expanduser().resolve()
    if root.exists() and (not root.is_dir() or any(root.iterdir())):
        if root.is_dir() and args.force and (root / MARKER).is_file():
            shutil.rmtree(root)
        elif args.force:
            sys.exit(f"make-demo: {root} is not empty and has no {MARKER} marker; refusing to delete it")
        else:
            sys.exit(f"make-demo: {root} exists and is not empty (use --force on a demo directory)")

    if args.now:
        try:
            now = datetime.fromisoformat(args.now).astimezone()
        except ValueError:
            sys.exit(f"make-demo: cannot read --now {args.now!r} (try 2026-10-14T09:30)")
    else:
        now = datetime.now().astimezone().replace(second=0, microsecond=0)
    clock = Clock(now)

    root.mkdir(parents=True, exist_ok=True)
    (root / MARKER).write_text("Created by scripts/demo/make-demo. Safe to delete or rebuild with --force.\n")
    write_configs(root)
    populate_mail(Mail(root / "Mail"), clock)
    populate_calendars(root / ".local" / "share" / "mailday" / "calendars", clock)

    write_env(root)
    index_with_notmuch(root)

    messages = sum(1 for p in (root / "Mail").rglob("*") if p.is_file())
    print(f"Built demo home in {root} ({messages} messages, now = {now:%Y-%m-%d %H:%M %Z})")
    print()
    print("Run Mailday against it (nothing reaches your own mail, daemon or calendars):")
    print(f"  (source {root}/env.sh && mailday)")
    return 0


def write_env(root: Path) -> None:
    """env.sh points every path Mailday reads into the demo home, including
    the daemon socket, so a running mailday-syncd of your own is never asked."""
    theme = Path(__file__).resolve().parent / "theme.toml"
    values = {
        "HOME": root, "XDG_CONFIG_HOME": root / ".config", "XDG_DATA_HOME": root / ".local/share",
        "XDG_STATE_HOME": root / ".local/state", "XDG_CACHE_HOME": root / ".cache",
        "XDG_RUNTIME_DIR": root / "run", "MAILDAY_CONFIG": root / ".config/mailday/config.toml",
        "MAILDAY_SYNCD_SOCKET": root / "run/none.sock", "NOTMUCH_CONFIG": root / ".notmuch-config",
        "MAILDAY_THEME": theme, "MAILDAY_HOME_TZ": "",
    }
    (root / "run").mkdir(mode=0o700, exist_ok=True)
    lines = [f"export {key}={shlex.quote(str(value))}" for key, value in values.items()]
    (root / "env.sh").write_text("# Source this to run Mailday against the demo home.\n" + "\n".join(lines) + "\n")


def index_with_notmuch(root: Path) -> None:
    """A notmuch index of the demo mail, so / searches bodies too."""
    if shutil.which("notmuch") is None:
        return
    (root / ".notmuch-config").write_text(
        f"[database]\npath={root / 'Mail'}\n[user]\nname=Alex Morgan\n"
        "primary_email=alex.morgan@northwind.example\nother_email=alex@morgan.example\n"
        "[new]\ntags=unread;inbox;\n[search]\nexclude_tags=deleted;spam;\n")
    env = dict(os.environ, NOTMUCH_CONFIG=str(root / ".notmuch-config"), HOME=str(root))
    subprocess.run(["notmuch", "new", "--quiet"], env=env, check=False,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


if __name__ == "__main__":
    raise SystemExit(main())
