# time helpers

class Clock:
    def __init__(self, now: datetime):
        self.now = now
        self.today = now.replace(hour=0, minute=0, second=0, microsecond=0)

    def at(self, days: int, hh: int, mm: int = 0) -> datetime:
        """Local wall-clock time `days` from today (negative = past)."""
        base = self.today + timedelta(days=days)
        return base.replace(hour=hh, minute=mm)

    def past(self, days_ago: int, hh: int, mm: int = 0) -> datetime:
        """A message time, never later than now."""
        when = self.at(-days_ago, hh, mm)
        if when >= self.now:
            when = self.now - timedelta(minutes=7 + 11 * (hh % 5))
        return when


def local_ics(dt: datetime) -> str:
    return dt.strftime("%Y%m%dT%H%M%S")


def utc_ics(dt: datetime) -> str:
    return dt.astimezone(timezone.utc).strftime("%Y%m%dT%H%M%SZ")


