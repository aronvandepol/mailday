#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Fetch a Microsoft 365 / Exchange calendar over EWS into <calendar>.ics.

Settings come from the [exchange] table of ~/.config/mailday/config.toml (path
override: $MAILDAY_CONFIG): calendar (name and file name, default "Outlook"),
user (mailbox address; empty means Exchange is off), token, client_id, ews_url,
mailbox_tz. Uses Thunderbird's registered Microsoft client ID by default, the
one Thunderbird itself uses for Exchange accounts, so no app registration of
your own is needed. The token is stored gpg-encrypted to your own key.

  mailday-exchange authorize   # once: browser login, Microsoft asks consent
  mailday-exchange sync        # write ~/.local/share/mailday/calendars/<calendar>.ics
"""
import base64, datetime as dt, hashlib, http.server, json, os, secrets, shutil, subprocess, sys
import tempfile, tomllib, urllib.error, urllib.parse, urllib.request, xml.etree.ElementTree as ET
from pathlib import Path
from zoneinfo import ZoneInfo


def load_config() -> dict:
    """Settings from $MAILDAY_CONFIG, else $XDG_CONFIG_HOME/mailday/config.toml,
    else ~/.config/mailday/config.toml. A missing file means defaults."""
    explicit = os.environ.get("MAILDAY_CONFIG")
    base = os.environ.get("XDG_CONFIG_HOME") or "~/.config"
    path = Path(explicit or Path(base) / "mailday" / "config.toml").expanduser()
    try:
        with open(path, "rb") as handle:
            return tomllib.load(handle)
    except FileNotFoundError:
        return {}
    except (OSError, tomllib.TOMLDecodeError) as error:
        sys.exit(f"{Path(sys.argv[0]).name}: cannot read {path}: {error}")


CONFIG = load_config()


def setting(section: str, key: str, default=""):
    value = (CONFIG.get(section) or {}).get(key)
    return default if value is None else value


# Thunderbird's public Microsoft client ID (OAuth2Providers.sys.mjs). Some
# tenants do not consent to it; set [exchange] client_id to your own app then.
CLIENT_ID = setting("exchange", "client_id", "9e5f94bc-e8a4-4e73-b8be-63364c29d753")
AUTHORIZE = "https://login.microsoftonline.com/common/oauth2/v2.0/authorize"
TOKEN = "https://login.microsoftonline.com/common/oauth2/v2.0/token"
SCOPE = "https://outlook.office.com/EWS.AccessAsUser.All offline_access"
EWS = setting("exchange", "ews_url", "https://outlook.office365.com/EWS/Exchange.asmx")
CALENDAR = setting("exchange", "calendar", "Outlook") or "Outlook"
LOGIN = os.environ.get("MAILDAY_EXCHANGE_USER") or setting("exchange", "user")
TOKEN_FILE = Path(os.environ.get("MAILDAY_EXCHANGE_TOKEN") or setting("exchange", "token", "~/.config/mailday/ews-token.gpg")).expanduser()
OUT = Path(os.environ.get("MAILDAY_ICS_DIR", "~/.local/share/mailday/calendars")).expanduser()
NS = {"m": "http://schemas.microsoft.com/exchange/services/2006/messages",
      "t": "http://schemas.microsoft.com/exchange/services/2006/types"}


def save_token(token: dict) -> None:
    TOKEN_FILE.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    # A name of its own per call: the calendar sync and a TUI write can both
    # refresh the token at once, and a shared .tmp made one replace() fail.
    handle, name = tempfile.mkstemp(prefix=TOKEN_FILE.name + ".", suffix=".tmp", dir=TOKEN_FILE.parent)
    os.close(handle)
    try:
        try:
            subprocess.run(["gpg", "--quiet", "--yes", "--batch", "--encrypt", "--default-recipient-self", "-o", name],
                           input=json.dumps(token).encode(), capture_output=True, check=True)
        except (subprocess.CalledProcessError, OSError) as error:
            sys.exit(f"gpg could not encrypt the token: {gpg_reason(error)}")
        os.chmod(name, 0o600)
        os.replace(name, TOKEN_FILE)
    finally:
        try:
            os.unlink(name)  # only still there when something above failed
        except FileNotFoundError:
            pass


def gpg_reason(error: Exception) -> str:
    stderr = getattr(error, "stderr", None) or b""
    lines = stderr.decode(errors="replace").strip().splitlines()
    return lines[-1] if lines else str(error)


def load_token() -> dict:
    if not TOKEN_FILE.exists():
        sys.exit(f"no token at {TOKEN_FILE}; run `mailday-exchange authorize` first")
    try:
        out = subprocess.run(["gpg", "--quiet", "--batch", "--decrypt", str(TOKEN_FILE)], capture_output=True, check=True)
    except (subprocess.CalledProcessError, OSError) as error:
        sys.exit(f"gpg could not decrypt {TOKEN_FILE}: {gpg_reason(error)}")
    return json.loads(out.stdout)


def token_request(params: dict) -> dict:
    data = urllib.parse.urlencode({"client_id": CLIENT_ID, "scope": SCOPE, **params}).encode()
    try:
        with urllib.request.urlopen(TOKEN, data, timeout=30) as resp:
            reply = json.load(resp)
    except urllib.error.HTTPError as e:
        body = json.loads(e.read() or b"{}")
        sys.exit(f"token request failed: {body.get('error')}: {(body.get('error_description') or '').splitlines()[0]}")
    reply["expires_at"] = dt.datetime.now().timestamp() + int(reply.get("expires_in", 3600)) - 120
    return reply


def require_user() -> None:
    if not LOGIN:
        sys.exit("mailday-exchange: Exchange is off. Set user = \"you@example.org\" under [exchange] in "
                 "~/.config/mailday/config.toml (or $MAILDAY_EXCHANGE_USER) first")


def authorize() -> None:
    require_user()
    verifier = secrets.token_urlsafe(64)
    challenge = base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest()).rstrip(b"=").decode()
    state = secrets.token_urlsafe(16)
    result = {}

    class Handler(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            query = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
            if query.get("state", [""])[0] != state:
                self.send_response(400); self.end_headers(); return
            result.update({k: v[0] for k, v in query.items()})
            self.send_response(200)
            self.send_header("Content-Type", "text/plain; charset=utf-8")
            self.end_headers()
            msg = "mailday: Exchange calendar connected. You can close this tab." if "code" in result \
                else f"mailday: login failed: {result.get('error_description', result.get('error'))}"
            self.wfile.write(msg.encode())

        def log_message(self, *args):
            pass

    server = http.server.HTTPServer(("127.0.0.1", 0), Handler)
    redirect = f"http://localhost:{server.server_port}"
    url = AUTHORIZE + "?" + urllib.parse.urlencode({
        "client_id": CLIENT_ID, "response_type": "code", "redirect_uri": redirect, "scope": SCOPE,
        "code_challenge": challenge, "code_challenge_method": "S256", "state": state,
        "login_hint": LOGIN, "prompt": "select_account"})
    print("Open this URL if no browser window appears:\n" + url, flush=True)
    opener = shutil.which("xdg-open") or shutil.which("open")
    if opener:
        subprocess.Popen([opener, url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    while not result:
        server.handle_request()
    if "code" not in result:
        sys.exit(f"login failed: {result.get('error')}: {result.get('error_description', '')}")
    token = token_request({"grant_type": "authorization_code", "code": result["code"],
                           "redirect_uri": redirect, "code_verifier": verifier})
    save_token(token)
    print(f"Saved token to {TOKEN_FILE}")


def access_token() -> str:
    token = load_token()
    if token.get("expires_at", 0) > dt.datetime.now().timestamp():
        return token["access_token"]
    fresh = token_request({"grant_type": "refresh_token", "refresh_token": token["refresh_token"]})
    fresh.setdefault("refresh_token", token["refresh_token"])
    save_token(fresh)
    return fresh["access_token"]


def find_items_window(bearer: str, start: dt.datetime, end: dt.datetime) -> tuple[list[ET.Element], bool]:
    """One FindItem call: the items, and whether the window was returned in full."""
    body = f"""<?xml version="1.0" encoding="utf-8"?>
<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/"
  xmlns:t="{NS['t']}" xmlns:m="{NS['m']}">
  <soap:Header><t:RequestServerVersion Version="Exchange2016"/></soap:Header>
  <soap:Body>
    <m:FindItem Traversal="Shallow">
      <m:ItemShape>
        <t:BaseShape>IdOnly</t:BaseShape>
        <t:AdditionalProperties>
          <t:FieldURI FieldURI="item:Subject"/>
          <t:FieldURI FieldURI="calendar:Start"/>
          <t:FieldURI FieldURI="calendar:End"/>
          <t:FieldURI FieldURI="calendar:IsAllDayEvent"/>
          <t:FieldURI FieldURI="calendar:Location"/>
          <t:FieldURI FieldURI="calendar:UID"/>
          <t:FieldURI FieldURI="calendar:IsCancelled"/>
          <t:FieldURI FieldURI="calendar:LegacyFreeBusyStatus"/>
          <t:FieldURI FieldURI="calendar:Organizer"/>
          <t:FieldURI FieldURI="calendar:MyResponseType"/>
          <t:FieldURI FieldURI="calendar:IsMeeting"/>
          <t:FieldURI FieldURI="calendar:CalendarItemType"/>
        </t:AdditionalProperties>
      </m:ItemShape>
      <m:CalendarView MaxEntriesReturned="1000" StartDate="{start.strftime('%Y-%m-%dT%H:%M:%SZ')}" EndDate="{end.strftime('%Y-%m-%dT%H:%M:%SZ')}"/>
      <m:ParentFolderIds><t:DistinguishedFolderId Id="calendar"/></m:ParentFolderIds>
    </m:FindItem>
  </soap:Body>
</soap:Envelope>"""
    req = urllib.request.Request(EWS, body.encode(), {
        "Authorization": f"Bearer {bearer}", "Content-Type": "text/xml; charset=utf-8",
        "X-AnchorMailbox": LOGIN})
    try:
        with urllib.request.urlopen(req, timeout=60) as resp:
            root = ET.fromstring(resp.read())
    except urllib.error.HTTPError as e:
        sys.exit(f"EWS request failed: HTTP {e.code} {e.reason}")
    message = root.find(".//m:FindItemResponseMessage", NS)
    if message is None or message.get("ResponseClass") != "Success":
        code = root.findtext(".//m:ResponseCode", default="unknown", namespaces=NS)
        sys.exit(f"EWS FindItem failed: {code}")
    return parse_find_items(root)


def parse_find_items(root: ET.Element) -> tuple[list[ET.Element], bool]:
    folder = root.find(".//m:RootFolder", NS)
    # Without the attribute there is nothing to say the window was cut short.
    complete = folder is None or folder.get("IncludesLastItemInRange", "true") != "false"
    return root.findall(".//t:CalendarItem", NS), complete


def find_items(bearer: str, start: dt.datetime, end: dt.datetime) -> list[ET.Element]:
    """Calendar items in the range. A CalendarView returns at most
    MaxEntriesReturned items and cannot be paged, so a window that comes back
    cut short is halved until each half fits (or is a day wide, when it is
    reported on stderr instead of dropped silently)."""
    items, complete = find_items_window(bearer, start, end)
    if complete:
        return items
    if end - start <= dt.timedelta(days=1):
        print(f"warning: more than 1000 calendar items between {start:%Y-%m-%d %H:%M} and {end:%Y-%m-%d %H:%M}; "
              "the rest are not synced", file=sys.stderr)
        return items
    middle = start + (end - start) / 2
    merged, seen = [], set()
    # An item spanning the middle comes back from both halves: keep it once.
    for item in find_items(bearer, start, middle) + find_items(bearer, middle, end):
        item_id = item.find("t:ItemId", NS)
        key = item_id.get("Id") if item_id is not None else None
        if key is not None and key in seen:
            continue
        seen.add(key)
        merged.append(item)
    return merged


def bodies(bearer: str, ids: list[str]) -> dict[str, str]:
    """Plain-text bodies of calendar items, 100 per GetItem call. FindItem
    cannot return bodies; these carry the notes and Teams join links."""
    found = {}
    for offset in range(0, len(ids), 100):
        chunk = "".join(f'<t:ItemId Id="{i}"/>' for i in ids[offset:offset + 100])
        body = f"""<?xml version="1.0" encoding="utf-8"?>
<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/"
  xmlns:t="{NS['t']}" xmlns:m="{NS['m']}">
  <soap:Header><t:RequestServerVersion Version="Exchange2016"/></soap:Header>
  <soap:Body>
    <m:GetItem>
      <m:ItemShape><t:BaseShape>IdOnly</t:BaseShape><t:BodyType>Text</t:BodyType>
        <t:AdditionalProperties><t:FieldURI FieldURI="item:Body"/></t:AdditionalProperties>
      </m:ItemShape>
      <m:ItemIds>{chunk}</m:ItemIds>
    </m:GetItem>
  </soap:Body>
</soap:Envelope>"""
        req = urllib.request.Request(EWS, body.encode(), {
            "Authorization": f"Bearer {bearer}", "Content-Type": "text/xml; charset=utf-8",
            "X-AnchorMailbox": LOGIN})
        try:
            with urllib.request.urlopen(req, timeout=60) as resp:
                root = ET.fromstring(resp.read())
        except (urllib.error.URLError, ET.ParseError):
            continue  # notes are a bonus; the calendar still syncs without them
        for item in root.iter(f"{{{NS['t']}}}CalendarItem"):
            item_id = item.find("t:ItemId", NS)
            text = (item.findtext("t:Body", default="", namespaces=NS) or "").strip()
            if item_id is not None and text:
                found[item_id.get("Id")] = text
    return found


def escape(text: str) -> str:
    return (text.replace("\\", "\\\\").replace(";", "\\;").replace(",", "\\,")
            .replace("\r\n", "\\n").replace("\n", "\\n").replace("\r", "\\n"))


def fold(line: str) -> str:
    raw, out = line.encode(), []
    while len(raw) > 75:
        cut = 75 if not out else 74
        while cut and (raw[cut] & 0xC0) == 0x80:
            cut -= 1
        out.append(raw[:cut].decode())
        raw = raw[cut:]
    out.append(raw.decode())
    return "\r\n ".join(out)


def mailbox_zone() -> ZoneInfo:
    """The zone the mailbox lives in. This is deliberately NOT the
    machine's zone: EWS reports an all-day event as midnight in the mailbox's
    zone (as UTC), so the date is only recovered by converting back with that
    same zone, wherever the laptop is. Set [exchange] mailbox_tz (env
    MAILDAY_EXCHANGE_MAILBOX_TZ wins); without it [calendar] home_zone is used,
    else UTC."""
    name = (os.environ.get("MAILDAY_EXCHANGE_MAILBOX_TZ") or setting("exchange", "mailbox_tz")
            or setting("calendar", "home_zone") or "UTC")
    try:
        return ZoneInfo(name)
    except (KeyError, ValueError, OSError):
        sys.exit(f"mailday-exchange: MAILDAY_EXCHANGE_MAILBOX_TZ / mailbox_tz={name!r} is not an IANA time zone")


def ics_time(value: str, all_day: bool) -> str:
    t = dt.datetime.fromisoformat(value.replace("Z", "+00:00"))
    if all_day:
        local = t.astimezone(mailbox_zone())
        return ";VALUE=DATE:" + local.strftime("%Y%m%d")
    return ":" + t.astimezone(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")


def sync(back: int, ahead: int) -> None:
    today = dt.datetime.now(dt.timezone.utc).replace(hour=0, minute=0, second=0, microsecond=0)
    bearer = access_token()
    items = find_items(bearer, today - dt.timedelta(days=back), today + dt.timedelta(days=ahead))
    notes = bodies(bearer, [i.find("t:ItemId", NS).get("Id") for i in items])
    now = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    lines = ["BEGIN:VCALENDAR", "VERSION:2.0", "PRODID:-//mailday//exchange//EN", f"X-WR-CALNAME:{CALENDAR}"]
    count = 0
    for item in items:
        if item.findtext("t:IsCancelled", namespaces=NS) == "true":
            continue
        start, end = item.findtext("t:Start", namespaces=NS), item.findtext("t:End", namespaces=NS)
        if not start or not end:
            continue
        all_day = item.findtext("t:IsAllDayEvent", namespaces=NS) == "true"
        uid = item.findtext("t:UID", namespaces=NS) or item.find("t:ItemId", NS).get("Id")
        lines += ["BEGIN:VEVENT", f"UID:{escape(uid)}", f"DTSTAMP:{now}",
                  "DTSTART" + ics_time(start, all_day), "DTEND" + ics_time(end, all_day),
                  f"SUMMARY:{escape(item.findtext('t:Subject', default='(no subject)', namespaces=NS))}"]
        if location := item.findtext("t:Location", namespaces=NS):
            lines.append(f"LOCATION:{escape(location)}")
        # Mailday moves and deletes through the item id (mailday-calendar);
        # only meetings the user organized, or plain appointments, are his to move.
        mine = (item.findtext("t:IsMeeting", namespaces=NS) != "true"
                or item.findtext("t:MyResponseType", namespaces=NS) == "Organizer")
        lines += [f"X-MAILDAY-ID:{escape(item.find('t:ItemId', NS).get('Id'))}",
                  f"X-MAILDAY-EDITABLE:{'TRUE' if mine else 'FALSE'}"]
        if item.findtext("t:CalendarItemType", namespaces=NS) in ("Occurrence", "Exception"):
            lines.append("X-MAILDAY-SERIES:TRUE")
        if text := notes.get(item.find("t:ItemId", NS).get("Id"), ""):
            # Teams bodies end in pages of dial-in boilerplate; keep the start.
            lines.append(f"DESCRIPTION:{escape(text[:4000])}")
        if organizer := item.findtext("t:Organizer/t:Mailbox/t:Name", namespaces=NS):
            if not mine:
                lines.append(f"X-MAILDAY-ORGANIZER:{escape(organizer)}")
        answer = {"NoResponseReceived": "needs-action", "Unknown": "needs-action", "Accept": "accepted",
                  "Tentative": "tentative", "Decline": "declined"}.get(item.findtext("t:MyResponseType", namespaces=NS) or "")
        if answer and not mine:
            lines.append(f"X-MAILDAY-RSVP:{answer}")
        if item.findtext("t:LegacyFreeBusyStatus", namespaces=NS) == "Tentative":
            lines.append("STATUS:TENTATIVE")
        lines.append("END:VEVENT")
        count += 1
    lines.append("END:VCALENDAR")
    OUT.mkdir(parents=True, exist_ok=True)
    target = OUT / f"{CALENDAR}.ics"
    tmp = target.with_suffix(".ics.tmp")
    tmp.write_text("\r\n".join(fold(l) for l in lines) + "\r\n")
    tmp.replace(target)
    print(f"{dt.datetime.now().isoformat(timespec='seconds')} wrote {CALENDAR.replace(' ', '_')}={count} to {OUT}")


def main() -> None:
    command = sys.argv[1] if len(sys.argv) > 1 else "sync"
    if command in ("authorize", "sync"):
        require_user()
    if command == "authorize":
        authorize()
    elif command == "sync":
        sync(back=30, ahead=180)
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
